{
  "reporter": ["text", "lcov", "html"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.type.ts",
    "**/*.types.ts",
    "src/journeys/**/index.ts",
    "test",
    "tests"
  ],
  "all": true,
  "sourceMap": true,
  "check-coverage": true,
  "lines": 20,
  "functions": 60,
  "branches": 70,
  "statements": 20
}
