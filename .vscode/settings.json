{
  // force vscode to resolve imports using path aliases
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.importModuleSpecifierEnding": "js",

  "files.associations": {
    "*.snyk": "yaml"
  },
  // force eslint formatting
  "editor.formatOnSave": false,
  "[typescript]": {
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/CVS": true,
    "**/.ruby-lsp": true,
    "**/node_modules": true,
    ".yarn/cache": true,
    ".yarn/install-state.gz": true,
    ".yarn/build-state.yml": true,
    ".yarn/unplugged": true,
    "**/.idea": true,
    "**/.trunk": true,
    "**/public": true,
    "**/.env": true,
    "**/.env.resolved": true,
    "test-results": true,
    "playwright-report": true,
    "blob-report": true,
    "tests/playwright/.cache": true,
    "**/coverage": true,
    "**/.local": true,
    "**/*.cjs": true
  },
  "gitignoreToggle.hidden": true
}
