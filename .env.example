
# General application configuration. these values are optional and have defaults, but can be overridden here if needed.
# PORT=3000
# SERVICE_NAME='LAA Record Controlled Work'
# AUTH_RATE_LIMIT_MAX=20
# CONTACT_EMAIL='CONTACT_EMAIL'
# CONTACT_PHONE='CONTACT_PHONE'
# RATE_LIMIT_MAX=100
# RATE_WINDOW_MS=900000 #15 * 60 * 1000 = 900000
# RATELIMIT_HEADERS_ENABLED=True
# RATELIMIT_STORAGE_URI='DATA_BASE_URL'
# SERVICE_PHASE='Alpha'
# SERVICE_URL='http://localhost:3000'
# API_MODE=api  # Legacy fallback - sets both RCW and PDA mode when service-specific vars are unset.
# RCW_API_MODE=api  # Set to "api" to connect to the real RCW API instead of MSW mocks (make watch / make dev-msw)
# PDA_API_MODE=msw  # Set to "msw" to mock PDA instead of calling the real (UAT) API - useful for `make docker-up`
# PDA_MSW_OFFICE_COUNT=10  # Number of offices returned by the PDA MSW mock (only used when PDA_API_MODE/API_MODE is "msw")

NODE_ENV=development
DEPARTMENT_NAME="Legal Aid Agency"
DEPARTMENT_URL='http://localhost:3000/landing'
SESSION_SECRET='s3Cur3'
ENTRA_AUTHORITY_BASE_URL="https://login.microsoftonline.com/"
ENTRA_REDIRECT_URI="http://localhost:3000/auth/code/callback"
# ENTRA_ADDITIONAL_SCOPES="scope.one,scope.two"

# 1Password is used to store sensitive secrets that might be needed locally.
# ALL SECRETS MUST BE MIRRORED IN DOCKER COMPOSE FILE.
#
# One password environment variables are injected when you run 
# `op run --env-file=.env -- `, followed by a command which uses .env
# 
# https://developer.1password.com/docs/cli/secret-reference-syntax

PDA_API_KEY="op://LAA Record Controlled Work/PDA-DEV/credential"

