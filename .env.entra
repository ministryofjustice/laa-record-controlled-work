# Entra-specific overrides for signing in via real Entra ID instead of the default
# mock-oauth2-server - see docker-compose.entra.yml.
#
# Not needed for the default `make docker-up` (`yarn dev:docker`) stack. Only loaded for
# `make docker-up-entra` (`yarn dev:docker:entra`), via an extra `op run --env-file=.env.entra`.
#
# Only RCW's own sign-in config lives here - rcw-api's resource-server validation config lives in
# its own .env.entra (../laa-record-controlled-work-api/.env.entra), so each repo's Entra config
# has a single source of truth.
#
# https://developer.1password.com/docs/cli/secret-reference-syntax

ENTRA_CLIENT_ID="op://LAA Record Controlled Work/RCW/ENTRA_CLIENT_ID"
ENTRA_TENANT_ID="op://LAA Record Controlled Work/RCW/ENTRA_TENANT_ID"
ENTRA_CLIENT_SECRET="op://LAA Record Controlled Work/RCW/ENTRA_CLIENT_SECRET"
