{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.ts",
    "esbuild/**/*.ts",
    "msw/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "orval/mocks/**/*.ts",
    "eslint.config.js",
    "src/browser/frontendPackagesEntry.ts",
    "src/scss/main.scss"
  ],
  "project": [
    "src/**/*.ts",
    "esbuild/**/*.ts",
    "msw/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "orval/mocks/**/*.ts",
    "eslint/**/*.js",
    "*.js",
    "*.ts"
  ],
  "include": ["dependencies", "unlisted", "binaries", "unresolved", "catalog"],
  "ignoreDependencies": ["@ministryofjustice/frontend", "govuk-frontend"],
  "ignoreBinaries": ["op"]
}
