{
  "name": "laa-record-controlled-work",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "op run --env-file=.env -- npx tsx src/server.ts",
    "dev:watch": "op run --env-file=.env -- yarn watch",
    "dev:docker": "op run --env-file=.env -- docker compose up --watch --build",
    "watch": "yarn build && concurrently \"tsc --watch\" \"node public/esbuild/esbuild.js --watch\" \"nodemon\"",
    "build": "yarn clean && tsc && node public/esbuild/esbuild.js",
    "clean": "rimraf public",
    "lint": "yarn eslint .",
    "lint:fix": "yarn eslint . --fix",
    "knip": "knip --config knip.json --reporter compact",
    "knip:fix": "yarn knip --fix --fix-type dependencies && echo '\nUnused dependencies removed. Updating lockfile ...' && yarn",
    "knip:trace": "yarn knip --trace-dependency",
    "unit": "./node_modules/.bin/mocha --recursive 'tests/unit/**/*.spec.ts'",
    "unit:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/unit/**/*.spec.ts'",
    "unit:coverage": "c8 yarn unit --check-coverage",
    "integration": "./node_modules/.bin/mocha --recursive 'tests/integration/**/*.spec.ts'",
    "integration:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/integration/**/*.spec.ts'",
    "e2e": "yarn playwright test --config=tests/playwright/playwright.config.ts",
    "e2e:ui": "yarn playwright test --config=tests/playwright/playwright.config.ts --ui",
    "test": "yarn unit && yarn integration && yarn e2e"
  },
  "engines": {
    "node": "25.9.0"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "@ministryofjustice/frontend": "9.0.0",
    "@ministryofjustice/hmpps-forge": "^0.1.0-alpha.16",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.1.0",
    "helmet": "^8.2.0",
    "i18next": "^26.3.0",
    "moment": "^2.30.1",
    "morgan": "~1.10.1",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/compression": "^1.8.1",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/parser": "^8.60.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "concurrently": "^9.2.1",
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.4.0",
    "eslint-config-love": "^153.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "knip": "^6.14.2",
    "lint-staged": "^16.4.0",
    "mocha": "^11.7.6",
    "msw": "^2.14.6",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.60.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.100.0",
    "sinon": "^21.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "packageManager": "yarn@4.15.0+sha512.07ec708ac11e2eaa4ea2b04cfbb272812f7e74a753f1595eaef4486c663a98306a30cca3e6fc40f7a0b168dcfb3a2490b6a5e0501e20fb69cc36f563dd161c53",
  "resolutions": {
    "@isaacs/brace-expansion": "5.0.5",
    "brace-expansion": "5.0.6",
    "serialize-javascript": "7.0.5",
    "lodash": "4.18.1"
  }
}
