{
  "name": "laa-record-controlled-work",
  "version": "1.0.1",
  "description": "LAA Record Controlled Work UI",
  "repository": "git@github.com:ministryofjustice/laa-record-controlled-work.git",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "postinstall": "[ -n \"${CI:-}\" ] || [ -n \"${DOCKER:-}\" ] || yarn prek:install",
    "api:generate": "yarn orval",
    "gitleaks:install": "sh ./scripts/install-gitleaks.sh",
    "prek:patch-hook-path": "sh ./scripts/patch-precommit-hook-path.sh",
    "prek:install": "yarn gitleaks:install && prek install && yarn prek:patch-hook-path",
    "dev": "op run --env-file=.env -- npx tsx scripts/dev-server-with-msw.ts",
    "dev:watch": "op run --env-file=.env -- yarn watch",
    "dev:docker": "op run --env-file=.env -- docker compose up --watch --build",
    "watch": "yarn build && concurrently \"tsc --watch\" \"node public/esbuild/esbuild.js --watch\" \"nodemon --exec 'npx tsx scripts/dev-server-with-msw.ts'\"",
    "build": "yarn clean && tsc && node public/esbuild/esbuild.js",
    "clean": "rimraf public",
    "lint": "yarn eslint .",
    "lint:fix": "yarn eslint . --fix",
    "knip": "knip --config knip.json --reporter compact",
    "knip:fix": "yarn knip --fix --fix-type dependencies && echo '\nUnused dependencies removed. Updating lockfile ...' && yarn",
    "knip:trace": "yarn knip --trace-dependency",
    "unit": "./node_modules/.bin/mocha --recursive 'tests/unit/**/*.spec.ts'",
    "unit:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/unit/**/*.spec.ts'",
    "unit:coverage": "c8 yarn unit --check-coverage",
    "integration": "./node_modules/.bin/mocha --recursive 'tests/integration/**/*.spec.ts'",
    "integration:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/integration/**/*.spec.ts'",
    "e2e": "yarn playwright test --config=tests/playwright/playwright.config.ts",
    "e2e:ui": "yarn playwright test --config=tests/playwright/playwright.config.ts --ui",
    "test": "yarn unit && yarn integration && yarn e2e"
  },
  "engines": {
    "node": "26.5.0"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.2",
    "@ministryofjustice/frontend": "9.0.0",
    "@ministryofjustice/hmpps-forge": "^0.3.2",
    "accessible-autocomplete": "^3.0.1",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.4.0",
    "helmet": "^8.3.0",
    "i18next": "^26.3.6",
    "moment": "^2.30.1",
    "morgan": "~1.11.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.1",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@faker-js/faker": "^10.5.0",
    "@j178/prek": "^0.4.11",
    "@playwright/test": "^1.62.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/compression": "^1.8.1",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.5",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.65.0",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "concurrently": "^10.0.4",
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.7.0",
    "eslint-config-love": "^154.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.2.2",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "knip": "^6.29.0",
    "mocha": "^11.7.6",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "orval": "^8.22.0",
    "playwright-core": "^1.62.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.100.0",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.17.1",
  "resolutions": {
    "brace-expansion": "5.0.8",
    "serialize-javascript": "7.0.7",
    "js-yaml": "4.3.0",
    "ws": "8.21.1"
  }
}
