{
  "name": "laa-record-controlled-work",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "postinstall": "[ -n \"${CI:-}\" ] || [ -n \"${DOCKER:-}\" ] || yarn prek:install",
    "prek:install": "prek install && echo Pre-commit hook is now installed  && echo This hook runs Moj Secrets Scanner - GitLeaks",
    "dev": "op run --env-file=.env -- npx tsx src/server.ts",
    "dev:watch": "op run --env-file=.env -- yarn watch",
    "dev:docker": "op run --env-file=.env -- docker compose up --watch --build",
    "watch": "yarn build && concurrently \"tsc --watch\" \"node public/esbuild/esbuild.js --watch\" \"nodemon\"",
    "build": "yarn clean && tsc && node public/esbuild/esbuild.js",
    "clean": "rimraf public",
    "lint": "yarn eslint .",
    "lint:fix": "yarn eslint . --fix",
    "knip": "knip --config knip.json --reporter compact",
    "knip:fix": "yarn knip --fix --fix-type dependencies && echo '\nUnused dependencies removed. Updating lockfile ...' && yarn",
    "knip:trace": "yarn knip --trace-dependency",
    "unit": "./node_modules/.bin/mocha --recursive 'tests/unit/**/*.spec.ts'",
    "unit:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/unit/**/*.spec.ts'",
    "unit:coverage": "c8 yarn unit --check-coverage",
    "integration": "./node_modules/.bin/mocha --recursive 'tests/integration/**/*.spec.ts'",
    "integration:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/integration/**/*.spec.ts'",
    "e2e": "yarn playwright test --config=tests/playwright/playwright.config.ts",
    "e2e:ui": "yarn playwright test --config=tests/playwright/playwright.config.ts --ui",
    "test": "yarn unit && yarn integration && yarn e2e"
  },
  "engines": {
    "node": "26.3.1"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.5",
    "@ministryofjustice/frontend": "9.0.0",
    "@ministryofjustice/hmpps-forge": "^0.1.0-alpha.22",
    "accessible-autocomplete": "^3.0.1",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.2.0",
    "helmet": "^8.2.0",
    "i18next": "^26.3.1",
    "moment": "^2.30.1",
    "morgan": "~1.11.0",
    "nunjucks": "^3.2.4",
    "pino": "^10.3.1",
    "redis": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@j178/prek": "^0.4.5",
    "@playwright/test": "^1.61.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/compression": "^1.8.1",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.4",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/parser": "^8.61.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "concurrently": "^9.2.3",
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.5.0",
    "eslint-config-love": "^154.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.6",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "knip": "^6.17.1",
    "mocha": "^11.7.6",
    "msw": "^2.14.6",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.61.0",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.100.0",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.17.0+sha512.c2957de2f9025ab14d63b24d0d8be1f1655810e22c341042c27f7ecd017b180ec12db73d69ac366d71b304ef9f069349ce462de96f04f8f1da317f4f762c95ae",
  "resolutions": {
    "@isaacs/brace-expansion": "5.0.5",
    "brace-expansion": "5.0.6",
    "serialize-javascript": "7.0.6",
    "lodash": "4.18.1"
  }
}
