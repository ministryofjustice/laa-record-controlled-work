{
  "name": "laa-record-controlled-work",
  "version": "1.0.1",
  "description": "LAA Record Controlled Work UI",
  "repository": "git@github.com:ministryofjustice/laa-record-controlled-work.git",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#orval/*": "./orval/*",
    "#msw/*": "./msw/*",
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "postinstall": "[ -n \"${CI:-}\" ] || [ -n \"${DOCKER:-}\" ] || yarn prek:install",
    "api:generate": "yarn orval",
    "gitleaks:install": "sh ./scripts/install-gitleaks.sh",
    "prek:patch-hook-path": "sh ./scripts/patch-precommit-hook-path.sh",
    "prek:install": "yarn gitleaks:install && prek install && yarn prek:patch-hook-path",
    "dev": "op run --env-file=.env -- npx tsx msw/dev-server-with-msw.ts",
    "dev:watch": "op run --env-file=.env -- yarn watch",
    "dev:docker": "./docker/compose/up",
    "dev:docker:entra": "./docker/compose/up --entra",
    "watch": "yarn build && concurrently \"tsc --watch\" \"node public/esbuild/esbuild.js --watch\" \"nodemon --exec 'npx tsx msw/dev-server-with-msw.ts'\"",
    "build": "yarn clean && tsc -p tsconfig.build.json && node public/esbuild/esbuild.js",
    "clean": "rimraf public",
    "lint": "yarn eslint .",
    "lint:fix": "yarn eslint . --fix",
    "knip": "knip --config knip.json --reporter compact",
    "knip:fix": "yarn knip --fix --fix-type dependencies && echo '\nUnused dependencies removed. Updating lockfile ...' && yarn",
    "knip:trace": "yarn knip --trace-dependency",
    "test:unit": "./node_modules/.bin/mocha --recursive 'tests/unit/**/*.spec.ts'",
    "test:unit:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/unit/**/*.spec.ts'",
    "test:unit:coverage": "c8 yarn test:unit --check-coverage",
    "test:integration": "yarn build && ./node_modules/.bin/mocha --recursive 'tests/integration/**/*.spec.ts'",
    "test:integration:watch": "./node_modules/.bin/mocha --watch --recursive 'tests/integration/**/*.spec.ts'",
    "test:ui": "yarn playwright test --config=tests/ui/playwright.config.ts",
    "test:ui:open": "yarn playwright test --config=tests/ui/playwright.config.ts --ui",
    "test:e2e": "yarn playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:open": "yarn playwright test --config=tests/e2e/playwright.config.ts --ui",
    "test": "yarn test:unit && yarn test:integration && yarn test:ui"
  },
  "engines": {
    "node": "26.8.0"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "@ministryofjustice/frontend": "10.0.1",
    "@ministryofjustice/hmpps-forge": "^0.3.6",
    "accessible-autocomplete": "^3.0.1",
    "body-parser": "^2.3.0",
    "compression": "^1.8.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "govuk-frontend": "^6.4.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.0",
    "moment": "^2.30.1",
    "morgan": "~1.11.0",
    "nunjucks": "^3.2.4",
    "path-to-regexp": "^8.4.2",
    "pino": "^10.3.1",
    "redis": "^6.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@j178/prek": "^0.4.14",
    "@playwright/test": "^1.62.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/compression": "^1.8.1",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.5",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.68.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "concurrently": "^10.0.5",
    "connect-livereload": "^0.6.1",
    "esbuild": "^0.28.2",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.9.1",
    "eslint-config-love": "^154.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "knip": "^6.32.3",
    "mocha": "^11.8.0",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "orval": "^8.24.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.103.1",
    "sinon": "^22.1.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "undici": "^8.10.0"
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "brace-expansion": "5.0.9",
    "serialize-javascript": "7.0.7",
    "js-yaml": "4.3.1",
    "ws": "8.21.1",
    "undici": "^8.10.0",
    "tar": "^7.5.21"
  }
}
