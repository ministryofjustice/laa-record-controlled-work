{
  "name": "laa-record-controlled-work",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "main": "public/app.js",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "node public/app.js",
    "start:docker": "docker compose --env-file docker-images.env up -d",
    "clean": "rimraf public",
    "build": "yarn clean && yarn build:ts && node public/esbuild.js",
    "lint": "yarn eslint . --fix",
    "dev": "op run --env-file=.env -- yarn build:ts && concurrently \"tsc --watch\" \"node public/esbuild.js --watch\" \"nodemon\"",
    "deploy": "./scripts/deploy.sh",
    "prepare": "husky",
    "tsc": "tsc --noEmit",
    "build:ts": "tsc",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "./node_modules/.bin/mocha",
    "test:watch": "./node_modules/.bin/mocha --watch",
    "test:e2e": "yarn playwright test --config=tests/playwright/playwright.config.ts",
    "coverage": "c8 yarn test:unit --check-coverage"
  },
  "engines": {
    "node": "25.9.0"
  },
  "dependencies": {
    "@azure/msal-node": "^5.1.5",
    "@ministryofjustice/frontend": "9.0.0",
    "axios": "1.15.2",
    "body-parser": "^2.2.2",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie-parser": "~1.4.7",
    "csrf-sync": "^4.2.1",
    "debug": "~4.4.3",
    "dotenv": "^17.4.2",
    "eslint-plugin-prettier": "^5.5.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "figlet": "^1.11.0",
    "fs-extra": "^11.3.4",
    "govuk-frontend": "^6.1.0",
    "helmet": "^8.1.0",
    "http-errors": "~2.0.1",
    "i18next": "^26.0.8",
    "libphonenumber-js": "^1.12.42",
    "middleware-axios": "^3.0.0",
    "moment": "^2.30.1",
    "morgan": "~1.10.1",
    "nunjucks": "^3.2.4",
    "redis": "^5.12.1",
    "validator": "^13.15.35",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/compression": "^1.8.1",
    "@types/connect-livereload": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/figlet": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/livereload": "^0.9.5",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "@types/nunjucks": "^3.2.6",
    "@types/sinon": "^21.0.1",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "axe-core": "^4.11.4",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "chokidar": "5.0.0",
    "concurrently": "^9.2.1",
    "connect-livereload": "^0.6.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.3.0",
    "eslint-config-love": "^152.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsonc": "^3.1.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "livereload": "^0.10.3",
    "mocha": "^11.7.5",
    "msw": "^2.14.2",
    "nodemon": "^3.1.14",
    "playwright-core": "^1.59.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "sass-embedded": "^1.99.0",
    "sinon": "^21.1.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix"
  },
  "packageManager": "yarn@4.14.1",
  "resolutions": {
    "@isaacs/brace-expansion": "5.0.5",
    "brace-expansion": "5.0.5",
    "serialize-javascript": "7.0.5",
    "lodash": "4.18.1"
  }
}
