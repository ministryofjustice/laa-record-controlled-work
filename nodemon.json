{
  "watch": ["src/**/*.ts", "locales/**/*.json"],
  "ext": "ts,js,json",
  "ignore": [
    "public/assets/**/*",
    "public/css/**/*",
    "public/js/**/*",
    "public/*.map",
    "public/**/*.map",
    "public/src/",
    "public/tests/",
    "public/types/",
    "node_modules/",
    "*.log",
    "*.tmp"
  ],
  "delay": "5000ms",
  "debounce": 2000,
  "verbose": false,
  "env": {
    "NODE_ENV": "development"
  },
  "exec": "npx tsx msw/dev-server-with-msw.ts"
}
