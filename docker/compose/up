#!/usr/bin/env bash
# Onboards the full local docker-compose stack: clones missing sibling repos, seeds any
# missing .env files from their .env.example/.env.sample templates, builds the CCQ image
# if it hasn't been already, then runs the `docker compose up` command.
#
# Every step that touches the filesystem, network or Docker is confirmed interactively
# first - answer "n" or Ctrl-C out at any prompt, and re-running this script later will
# pick up from whatever's still missing. Use --ci to skip all confirmations (for CI).
#
# Usage: docker/compose/up [--entra] [--ci] [--no-build]
#   --entra  Load .env.entra overrides (Entra auth mode; default: mock-issuer)
#   --ci     CI mode: skip confirmations, skip 1Password, auto-add /etc/hosts, exit after stack ready
#   --no-build  Use a loaded RCW runner image (requires --ci)
set -euo pipefail

ENTRA_MODE=false
CI_MODE=false
NO_BUILD=false

# Parse named arguments.
while [[ $# -gt 0 ]]; do
  case "$1" in
    --entra) ENTRA_MODE=true; shift ;;
    --ci) CI_MODE=true; shift ;;
    --no-build) NO_BUILD=true; shift ;;
    *)
      echo "Usage: $0 [--entra] [--ci] [--no-build]" >&2
      exit 1
      ;;
  esac
done

if [[ "$NO_BUILD" == true && "$CI_MODE" != true ]]; then
  echo "error: --no-build requires --ci" >&2
  exit 1
fi

confirm() {
  local prompt="$1" reply
  if [[ "$CI_MODE" == true ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    echo "error: no interactive terminal available to confirm: $prompt" >&2
    return 1
  fi
  read -r -p "$prompt [y/N] " reply
  [[ "$reply" =~ ^[Yy]([Ee][Ss])?$ ]]
}

require_confirm() {
  confirm "$1" || {
    echo "Skipped - re-run this script once you're ready to continue." >&2
    exit 1
  }
}

require_commands() {
  local command
  for command in "$@"; do
    command -v "$command" >/dev/null 2>&1 || {
      echo "error: $command is required but not installed" >&2
      exit 1
    }
  done
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PARENT_DIR="$(dirname "$REPO_ROOT")"
cd "$REPO_ROOT"

# CI does not use 1Password, so it only needs git and Docker.
if [[ "$CI_MODE" == true ]]; then
  require_commands git docker
else
  require_commands git docker op
fi

# Keep sibling clone URLs consistent with this repository's remote.
ORG_URL="$(git remote get-url origin)"
ORG_URL="${ORG_URL%/*}"

API_DIR="$PARENT_DIR/laa-record-controlled-work-api"
DATASTORE_DIR="$PARENT_DIR/laa-info-and-advice-datastore"
CCQ_DIR="$PARENT_DIR/laa-check-client-qualifies"
CFE_DIR="$PARENT_DIR/cfe-civil"

clone_if_missing() {
  local dir="$1" name="$2" url="$ORG_URL/$2.git"
  [[ -d "$dir" ]] && return 0
  echo "$name is not checked out at $dir."
  require_confirm "Run 'git clone $url $dir'?"
  # Remove a partial clone if this is interrupted, so re-running this script retries cleanly.
  trap 'rm -rf "$dir"' INT TERM
  if [[ "$CI_MODE" == true ]]; then
    git clone --depth 1 --single-branch "$url" "$dir"
  else
    git clone "$url" "$dir"
  fi
  trap - INT TERM
}

clone_if_missing "$API_DIR" laa-record-controlled-work-api
clone_if_missing "$DATASTORE_DIR" laa-info-and-advice-datastore
clone_if_missing "$CCQ_DIR" laa-check-client-qualifies
clone_if_missing "$CFE_DIR" cfe-civil

ensure_env_file() {
  local dir="$1" file="$2" example="$3"
  [[ -f "$dir/$file" ]] && return 0
  echo "$dir/$file is missing (holds only dev-only 1Password references, never real secrets)."
  require_confirm "Create it by copying $example?"
  # Copy via a temp file + mv so an interrupted copy can't leave a corrupt/partial .env behind.
  cp "$dir/$example" "$dir/$file.tmp"
  mv "$dir/$file.tmp" "$dir/$file"
}

ensure_entra_env_files() {
  [[ "$ENTRA_MODE" == true ]] || return 0

  ensure_env_file "$REPO_ROOT" .env.entra .env.entra.example
  ensure_env_file "$API_DIR" .env.entra .env.entra.example
  ensure_env_file "$DATASTORE_DIR" .env.entra .env.entra.example
}

build_ccq_image_if_missing() {
  [[ "$CI_MODE" == true ]] && return 0
  docker image inspect laa-check-client-qualifies:latest >/dev/null 2>&1 && return 0

  # docker-compose.embedded.yml sets pull_policy: never.
  echo "laa-check-client-qualifies:latest image is missing."
  require_confirm "Run 'make -C $CCQ_DIR build'?"
  make -C "$CCQ_DIR" build
}

ensure_docker_host_entry() {
  # Docker Desktop on macOS does not add this browser host entry automatically.
  if grep -qE '(^|[[:space:]])host\.docker\.internal([[:space:]]|$)' /etc/hosts 2>/dev/null; then
    return 0
  fi

  if [[ "$CI_MODE" == true ]]; then
    echo "Adding host.docker.internal to /etc/hosts..."
    echo '127.0.0.1 host.docker.internal' | sudo tee -a /etc/hosts >/dev/null
    return 0
  fi

  echo "warning: host.docker.internal not found in /etc/hosts - add it so the mock OAuth2 login page loads in your browser:" >&2
  echo "  echo '127.0.0.1 host.docker.internal' | sudo tee -a /etc/hosts" >&2
}

build_env_files() {
  ENV_FILES=(--env-file="$API_DIR/.env")
  if [[ "$ENTRA_MODE" == true ]]; then
    ENV_FILES+=(--env-file="$API_DIR/.env.entra")
  fi
  ENV_FILES+=(--env-file="$DATASTORE_DIR/.env")
  if [[ "$ENTRA_MODE" == true ]]; then
    ENV_FILES+=(--env-file="$DATASTORE_DIR/.env.entra")
  fi
  ENV_FILES+=(--env-file=.env)
  if [[ "$ENTRA_MODE" == true ]]; then
    ENV_FILES+=(--env-file=.env.entra)
  fi
}

build_compose_files() {
  COMPOSE_FILES=(-f docker-compose.yml -f docker-compose.override.yml)
  if [[ "$CI_MODE" == true ]]; then
    COMPOSE_FILES+=(-f docker/compose/ci.yml)
  fi
  if [[ "$NO_BUILD" == true ]]; then
    COMPOSE_FILES+=(-f docker/compose/ci.rcw.yml)
  fi
  if [[ "$ENTRA_MODE" == true ]]; then
    COMPOSE_FILES+=(-f docker-compose.entra.yml)
  fi
}

ensure_env_file "$REPO_ROOT" .env .env.example
ensure_env_file "$API_DIR" .env .env.example
ensure_env_file "$DATASTORE_DIR" .env .env.example
ensure_env_file "$CCQ_DIR" .env .env.sample

ensure_entra_env_files
build_ccq_image_if_missing
ensure_docker_host_entry
build_env_files
build_compose_files

if [[ "$CI_MODE" == true ]]; then
  # Pull runtime images while building RCW, then wait for health.
  auth_mode="mock-issuer"
  if [[ "$ENTRA_MODE" == true ]]; then
    auth_mode="entra"
  fi

  echo "==> Starting docker compose stack (CI mode, $auth_mode):"
  pull_status=0
  docker compose "${COMPOSE_FILES[@]}" "${ENV_FILES[@]}" pull --ignore-buildable &
  pull_pid=$!

  build_status=0
  if ! $NO_BUILD; then
    printf '        docker compose %s %s build --parallel\n' "${COMPOSE_FILES[*]}" "${ENV_FILES[*]}"
    docker compose "${COMPOSE_FILES[@]}" "${ENV_FILES[@]}" build --parallel || build_status=$?
  fi

  wait "$pull_pid" || pull_status=$?
  if (( build_status != 0 || pull_status != 0 )); then
    echo "==> Docker image preparation failed (build=$build_status, pull=$pull_status)."
    exit 1
  fi

  printf '        docker compose %s %s up -d --wait --no-build --pull never\n' "${COMPOSE_FILES[*]}" "${ENV_FILES[*]}"
  if ! docker compose "${COMPOSE_FILES[@]}" "${ENV_FILES[@]}" up -d --wait --no-build --pull never; then
    echo "==> Docker compose failed; service state:"
    docker compose "${COMPOSE_FILES[@]}" "${ENV_FILES[@]}" ps --all || true
    echo "==> Docker compose logs:"
    docker compose "${COMPOSE_FILES[@]}" "${ENV_FILES[@]}" logs --no-color || true
    exit 1
  fi
else
  auth_mode="mock-issuer"
  if [[ "$ENTRA_MODE" == true ]]; then
    auth_mode="entra"
  fi

  echo "==> Starting docker compose stack (interactive mode, $auth_mode):"
  echo "      op run"
  printf '        %s\n' "${ENV_FILES[@]}"
  echo "        -- docker compose ${COMPOSE_FILES[*]} up --watch --build"
  exec op run "${ENV_FILES[@]}" -- docker compose "${COMPOSE_FILES[@]}" up --watch --build
fi
