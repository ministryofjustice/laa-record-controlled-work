{
  "extends": ["github>ministryofjustice/devsecops-actions"],
  "schedule": [
    "after 10pm every weekday",
    "every weekend",
    "before 5am every weekday"
  ],
  "timezone": "Europe/London",

  "packageRules": [
    {
      "description": "Ungroup NPM updates to enforce minimum release age rules",
      "matchDatasources": ["npm"],
      "groupName": null
    },
    {
      "description": "Group playwight packages together to reduce falures",
      "matchDatasources": ["playwright-core", "@playwright/test"],
      "groupName": "playwright"
    },
    {
      "description": "Group Node.js packages together to reduce PR noise",
      "matchDepNames": ["node"],
      "matchManagers": ["npm", "nvm", "mise", "dockerfile"],
      "minimumGroupSize": 4,
      "groupName": "Node.js"
    },
    {
      "description": "Automerge patch and minor updates to reduce noise",
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "7 days",
      "automerge": true,
      "automergeType": "pr",
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Daily lockfile maintenance. Age gating is handled natively by Yarn's npmMinimalAgeGate:7d in .yarnrc",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "schedule": [
        "after 10pm every weekday",
        "before 5am every weekday",
        "every weekend"
      ],
      "rebaseWhen": "conflicted",
      "automerge": true,
      "automergeType": "pr",

      "minimumReleaseAge": null
    },
    {
      "description": "Ignore Yarn resolutions",
      "matchManagers": ["npm"],
      "matchDepTypes": ["resolutions"],
      "enabled": false
    }
  ]
}
