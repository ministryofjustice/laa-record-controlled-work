include               /etc/nginx/maps.conf;

log_format json_combined escape=json
  '{'
    '"time":"$time_iso8601",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"response_time":$request_time,'
    '"bytes_sent":$bytes_sent,'
    '"remote_addr":"$remote_addr",'
    '"http_x_forwarded_for":"$http_x_forwarded_for",'
    '"http_referer":"$http_referer",'
    '"http_user_agent":"$http_user_agent",'
    '"request_id":"$http_x_request_id"'
  '}';

# Do not include nginx version in error pages or Server header
server_tokens         off;
# Prevent oversized request bodies; sufficient for all expected form submissions
client_max_body_size  10m;

server {
  listen 8080;

  access_log /var/log/nginx/access.log json_combined;

  # MoJ CP/EKS ranges
  set_real_ip_from   10.0.0.0/8;
  set_real_ip_from   172.16.0.0/12;
  real_ip_header     X-Forwarded-For;
  real_ip_recursive  on;

  # Suppress access logging on the OAuth callback to keep auth codes out of logs
  location = /auth/code/callback {
    include     /etc/nginx/proxy.conf;
    proxy_pass  http://${NGINX_UPSTREAM_RCW};
    access_log  off;
  }

  # Never expose internal-only RCW private API routes via ingress.
  location = /api/private {
    return 404;
  }

  location ^~ /api/private/ {
    return 404;
  }

  location / {
    include     /etc/nginx/proxy.conf;
    proxy_pass  http://${NGINX_UPSTREAM_RCW};
  }

  location /ccq/assets/ {
    include     /etc/nginx/proxy.conf;
    proxy_pass  http://${NGINX_UPSTREAM_CCQ};
    
    # Strip session cookies from assets for performance
    proxy_hide_header        Set-Cookie;
    proxy_ignore_headers     Set-Cookie;

    # Force browser caching
    expires                  30d;
    add_header Cache-Control "public, max-age=2592000";
    access_log               off;
  }

  # match anything with `/eligibility` and forward the whole thing to CCQ
  location ~ /eligibility(/|$) {
    include     /etc/nginx/proxy.conf;
    proxy_pass  http://${NGINX_UPSTREAM_CCQ};
  }
}

# Health endpoint on a separate port so it is never reachable via the ingress
server {
  listen 9090;

  location /nginx-health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok";
  }
}
