{%
  set pagination = {
      total: data.length,
      page: 1,
      limit: 5
  }
%}

{% block content %}
  <h1 class="govuk-heading-xl">{{ t('pages.yourCases.pageTitle') }}</h1>
  {{
    govukButton({
        text: t('pages.yourCases.createCaseButton'),
        href: '/create-application',
        isStartButton: true
    })
  }}

  {% if data and data.length > 0 %}
    {# Render the sortable table with dynamic configuration #}
    {{
      sortableTableComponent({
        id: tableId,
        data: data,
        columns: [
          { key: "clientName", text: t('pages.yourCases.table.columns.clientName'), link: "/cases/{{referenceNumber}}/client-details", sortable: true },
          { key: "referenceNumber", text: t('pages.yourCases.table.columns.referenceNumber'), sortable: true },
          { key: "lastUpdated", text: t('pages.yourCases.table.columns.lastUpdated'), sortable: true }
        ],
        sortBy: sortBy or defaultSortBy,
        sortOrder: sortOrder or "desc",
        basePath: "/your-cases"
      })
    }}

    {# Render pagination if pagination data is available #}
    {% if pagination %}
      {{
        paginationComponent({
          pagination: pagination,
          sortBy: sortBy or defaultSortBy,
          sortOrder: sortOrder or "desc",
          basePath: "/your-cases"
        })
      }}
    {% endif %}
  {% else %}
    <p>{{ emptyMessage }}</p>
  {% endif %}
{% endblock %}
