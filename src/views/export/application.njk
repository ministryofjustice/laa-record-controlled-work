<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/{{ getAsset('main', 'css') }}">
    <title>Record civil controlled work - Export</title>
  </head>
  <body class="app-export">
    <main class="govuk-width-container">
      <p class="govuk-body app-export__case-summary">
        <span>{{ t("pages.export.client") }}:</span>
        <strong>{{ clientName or t("pages.export.notProvided") }}</strong>
        <span>{{ t("pages.export.referenceNumber") }}:</span>
        <strong>{{ applicationRefNumber or t("pages.export.notProvided") }}</strong>
      </p>

      <img
        class="app-export__logo"
        src="/views/icons/laa-logo.svg"
        alt="{{ t('pages.export.logoAlt') }}"
      >

      <h1 class="govuk-heading-xl app-export__heading">{{ config.app.service.name }}</h1>
    </main>
  </body>
</html>