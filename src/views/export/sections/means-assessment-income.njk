{% if meansAssessment.calculations.status == "ready" %}
  {% if meansAssessment.incomeBreakdown.status == "ready" %}
    <h3 class="govuk-heading-m">
      {{ meansAssessment.incomeBreakdown.heading }}
    </h3>
    {% for table in meansAssessment.incomeBreakdown.tables %}
      {% if table.hint %}
        <p class="govuk-body">{{ table.hint }}</p>
      {% endif %}
      <table class="govuk-table app-means-assessment__calculation-table">
        <caption class="govuk-table__caption govuk-table__caption--m">
          {{ table.heading }}
        </caption>
        <tbody class="govuk-table__body">
          {% for row in table.rows %}
            <tr{% if row.emphasis %} class="app-calculation__row--emphasis"{% endif %}>
              <th scope="row" class="govuk-table__header app-calculation__row-heading">
                {{ row.heading }}
                {% if row.hint %}
                  <span class="govuk-hint govuk-!-margin-bottom-0">{{ row.hint }}</span>
                {% endif %}
              </th>
              <td class="govuk-table__cell app-calculation__amount">{{ row.amount }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endfor %}
  {% elif meansAssessment.incomeBreakdown.status == "unavailable" %}
    <h3 class="govuk-heading-m">
      {{ meansAssessment.incomeBreakdown.heading }}
    </h3>
    <p class="govuk-body">{{ meansAssessment.incomeBreakdown.message }}</p>
  {% endif %}
{% endif %}