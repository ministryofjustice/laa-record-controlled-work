{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set clientDetailsT = fixedT("pages.export.clientAndCaseDetails") %}

{% set accessedLegalAidBeforeText = "" %}
{% if clientAndCaseDetails.accessedLegalAidBefore == true %}
  {% set accessedLegalAidBeforeText = t("common.yes") %}
{% elif clientAndCaseDetails.accessedLegalAidBefore == false %}
  {% set accessedLegalAidBeforeText = t("common.no") %}
{% endif %}

{% set addressValue = { text: "" } %}
{% if clientAndCaseDetails.address == null %}
  {% set addressValue = { text: clientDetailsT("noFixedAddress") } %}
{% else %}
  {% set addressLinesHtml %}{% for line in clientAndCaseDetails.address %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% endset %}
  {% set addressValue = { html: addressLinesHtml } %}
{% endif %}

{% set rows = [
  {
    key: { text: clientDetailsT("ecf") },
    value: { text: t("common.no") }
  },
  {
    key: { text: clientDetailsT("typeOfFamilyLaw") },
    value: { text: clientAndCaseDetails.typeOfFamilyLaw or "" }
  },
  {
    key: { text: clientDetailsT("transitionalEuArrangements") },
    value: { text: clientAndCaseDetails.transitionalEuArrangements or "" }
  },
  {
    key: { text: clientDetailsT("protectThemselfOrChildren") },
    value: { text: clientAndCaseDetails.protectThemselfOrChildren or "" }
  },
  {
    key: { text: clientDetailsT("evidenceCaseIsInScope") },
    value: { text: clientAndCaseDetails.evidenceCaseIsInScope or "" }
  },
  {
    key: { text: clientDetailsT("confirmMerits") },
    value: { text: clientAndCaseDetails.confirmMerits or "" }
  },
  {
    key: { text: clientDetailsT("accessedLegalAidBefore") },
    value: { text: accessedLegalAidBeforeText }
  }
] %}

{% if clientAndCaseDetails.sameMatterDetails %}
  {% set rows = rows.concat([
    {
      key: { text: clientDetailsT("sameMatterWithin6Months") },
      value: { text: t("common.yes") if clientAndCaseDetails.sameMatterDetails.sameMatterWithin6Months else t("common.no") }
    }
  ]) %}

  {% if clientAndCaseDetails.sameMatterDetails.reasonForReapplication %}
    {% set rows = rows.concat([
      {
        key: { text: clientDetailsT("reasonForReapplication") },
        value: { text: clientAndCaseDetails.sameMatterDetails.reasonForReapplication }
      }
    ]) %}
  {% endif %}
{% endif %}

{% set rows = rows.concat([
  {
    key: { text: clientDetailsT("firstName") },
    value: { text: clientAndCaseDetails.firstName }
  },
  {
    key: { text: clientDetailsT("lastName") },
    value: { text: clientAndCaseDetails.lastName }
  },
  {
    key: { text: clientDetailsT("dateOfBirth") },
    value: { text: clientAndCaseDetails.dateOfBirth }
  }
]) %}

{% if clientAndCaseDetails.niNumber %}
  {% set rows = rows.concat([
    {
      key: { text: clientDetailsT("niNumber") },
      value: { text: clientAndCaseDetails.niNumber }
    }
  ]) %}
{% endif %}

{% set rows = rows.concat([
  {
    key: { text: clientDetailsT("address") },
    value: addressValue
  }
]) %}

<h2 class="govuk-heading-l">{{ clientDetailsT("heading") }}</h2>

{{ govukSummaryList({
  rows: rows
}) }}
